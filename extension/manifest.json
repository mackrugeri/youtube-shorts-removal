{
  "manifest_version": 3,
  "name": "YouTube Shorts Removal",
  "version": "0.1.0",
  "description": "Preview the Hide Shorts controls for desktop YouTube.",
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess",
    "webNavigation"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "YouTube Shorts Removal",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": [
        "shared/routes.js",
        "shared/selectors.js",
        "content/content.js"
      ],
      "css": [
        "content/early.css"
      ],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "shorts_redirect",
        "enabled": true,
        "path": "rules/shorts-redirect.json"
      }
    ]
  }
}
